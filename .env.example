# Скопіюйте у .env і заповніть. Файл .env у репозиторій не потрапляє.
# PostgreSQL: postgresql+psycopg://користувач:пароль@хост:порт/база
DATABASE_URL=
# Довгий випадковий рядок для підпису сесій: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Пароль бази для docker compose
POSTGRES_PASSWORD=
# 1 — демонстраційний вхід без пароля (вибір користувача набору); 0 — логін і пароль
DEMO_MODE=1
# 1 — якщо база порожня, завантажити синтетичний набір організаторів
AUTO_IMPORT=1
# Каталог для файлів підтвердних матеріалів і обмеження розміру, МБ
UPLOAD_DIR=
MAX_FILE_MB=10
# 1 — якщо застосунок працює за проксі (nginx)
TRUST_PROXY=0
