POSTGRES_DB=bordergroup
POSTGRES_USER=postgres
# Задайте власний пароль лише в локальному .env перед запуском.
POSTGRES_PASSWORD=

# Окремий користувач застосунку, не postgres; створення узгоджується з бекендом.
# postgresql+psycopg://<app_user>:<URL-encoded-password>@db:5432/bordergroup
DATABASE_URL=
APP_NAME=BorderGroup
DEBUG=false
SQL_ECHO=false

# Згенеруйте окремий секрет для JWT лише в локальному .env.
JWT_SECRET_KEY=

# Ollama в мережі Docker Compose
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
