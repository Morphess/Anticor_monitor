FROM python:3.13-slim-bookworm
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app/ ./backend/app/
COPY alembic.ini ./alembic.ini
COPY alembic/ ./alembic/
COPY frontend/ ./frontend/
COPY e2e/support/ ./e2e/
RUN mkdir -p /app/storage/orders /app/storage/reports && chown -R 10001:10001 /app/storage
WORKDIR /app/backend
ENV PYTHONPATH=/app/backend
USER 10001:10001
CMD ["sh", "-ec", "python /app/e2e/check_analysis_migration.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
