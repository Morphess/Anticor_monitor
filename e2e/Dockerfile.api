FROM python:3.13-slim-bookworm
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app/ ./backend/app/
COPY backend/alembic.ini ./backend/alembic.ini
COPY backend/alembic/ ./backend/alembic/
COPY frontend/ ./frontend/
COPY e2e/support/ ./e2e/
RUN mkdir -p /app/storage/orders /app/storage/reports && chown -R 10001:10001 /app/storage
WORKDIR /app/backend
ENV PYTHONPATH=/app/backend
USER 10001:10001
CMD ["sh", "-ec", "alembic -c /app/backend/alembic.ini upgrade head && python /app/e2e/seed.py && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
